{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "strict": true,
    "paths": {
      "@app/*": ["./src/app/*"],
      "@core/*": ["./src/core/*"],
      "@domain/*": ["./src/domain/*"],
      "@data/*": ["./src/data/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@assets/*": ["./src/assets/*"],
      "@type/*": ["./src/type/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/type/**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}